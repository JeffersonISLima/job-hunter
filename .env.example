# Local (code is baked into the image — rebuild after source changes):
#   docker compose up --build -d
#
# CD in .github/workflows/deploy.yml already runs: docker compose up --build -d

OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Fallback for a paid model
OPENAI_MODEL_FALLBACK=openai/gpt-4o-mini

TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
